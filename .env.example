# MongoDB connection string for saving DSC applications.
MONGODB_URI=mongodb://localhost:27018/event-registration

# Admin console credentials. Choose a unique password for production.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=replace-this-with-a-long-random-password

# Used to sign the secure admin session cookie. Use at least 32 random characters.
# Generate one with: openssl rand -base64 48
ADMIN_SESSION_SECRET=replace-this-with-at-least-32-random-characters
